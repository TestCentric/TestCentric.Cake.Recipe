<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="nuget" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="project" value="packages" />
	</packageSources>
	<packageSourceMapping>
		<!-- Default package source -->
		<packageSource key="nuget">
			<package pattern="*" />
		</packageSource>
		<!-- Packages created by this project, so they can be installed for testing -->
		<packageSource key="project">
			<package pattern="TestCentric.Cake.Recipe" />
		</packageSource>
	</packageSourceMapping>
</configuration>
